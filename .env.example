# Android MCP — Configuration
# Copier ce fichier en .env et ajuster les valeurs

# Token d'authentification partagé avec l'app compagnon
# Doit correspondre exactement à ce qui est configuré dans l'app
ANDROID_MCP_TOKEN=mcp-shared-secret-2026

# Ports (ne modifier qu'en cas de conflit)
RELAY_WS_PORT=8765
RELAY_HTTP_PORT=8090
STREAM_PORT=8766
BEACON_PORT=8764

# Log level : DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=WARNING
